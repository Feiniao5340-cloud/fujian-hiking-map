page {
  min-height: 100%;
  background: #f4f1e9;
  color: #1e332d;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view,
text,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  line-height: inherit;
}

button::after {
  border: 0;
}
