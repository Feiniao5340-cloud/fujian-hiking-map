.detail-page {
  min-height: 100vh;
  padding: 27rpx 32rpx 54rpx;
}

.detail-hero {
  position: relative;
  height: 430rpx;
  overflow: hidden;
  border-radius: 19rpx;
  background: linear-gradient(150deg, #829782 0%, #567260 53%, #29493c 100%);
  color: #fffaf0;
}

.detail-hero::after {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(28, 54, 42, 0.07) 20%, rgba(25, 49, 39, 0.7) 100%);
  content: "";
}

.detail-orb {
  position: absolute;
  top: 64rpx;
  right: 88rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #dec993;
  opacity: 0.85;
}

.detail-hill {
  position: absolute;
  right: -55rpx;
  bottom: -92rpx;
  left: -50rpx;
  height: 245rpx;
  border-radius: 50% 50% 0 0 / 35% 35% 0 0;
  transform: rotate(-8deg);
}

.hill-back {
  bottom: -60rpx;
  left: 90rpx;
  background: rgba(191, 192, 155, 0.58);
  transform: rotate(9deg);
}

.hill-front {
  background: rgba(34, 70, 53, 0.82);
}

.detail-hero-top {
  position: absolute;
  z-index: 1;
  top: 25rpx;
  right: 25rpx;
  left: 25rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mock-label {
  color: rgba(255, 250, 240, 0.91);
  font-size: 17rpx;
  letter-spacing: 2rpx;
}

.route-type-label {
  padding: 6rpx 15rpx;
  border: 1rpx solid rgba(255, 250, 240, 0.68);
  border-radius: 25rpx;
  color: #fffaf0;
  font-size: 17rpx;
}

.detail-hero-copy {
  position: absolute;
  z-index: 1;
  right: 28rpx;
  bottom: 32rpx;
  left: 28rpx;
  display: flex;
  flex-direction: column;
}

.detail-location {
  color: rgba(255, 250, 240, 0.8);
  font-size: 19rpx;
}

.detail-title {
  margin-top: 3rpx;
  font-size: 45rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.detail-place {
  margin-top: 4rpx;
  color: rgba(255, 250, 240, 0.8);
  font-size: 19rpx;
}

.stats-card {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  min-height: 131rpx;
  margin: -2rpx 13rpx 0;
  padding: 19rpx 10rpx;
  border: 1rpx solid #ebe6dc;
  border-radius: 13rpx;
  background: #fffdf8;
  box-shadow: 0 8rpx 24rpx rgba(47, 57, 45, 0.055);
}

.stat-cell {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  color: #878c82;
  font-size: 17rpx;
}

.stat-value {
  margin-top: 7rpx;
  color: #30483b;
  font-size: 22rpx;
  font-weight: 600;
}

.stat-divider {
  width: 1rpx;
  height: 49rpx;
  background: #e5e1d7;
}

.detail-section {
  margin: 39rpx 8rpx 0;
}

.section-heading {
  display: flex;
  align-items: center;
}

.section-marker {
  color: #b17a58;
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.section-name {
  margin-left: 13rpx;
  color: #263c32;
  font-size: 27rpx;
  font-weight: 600;
}

.summary-copy {
  display: block;
  margin-top: 15rpx;
  color: #6f786f;
  font-size: 22rpx;
  line-height: 1.8;
}

.info-section {
  padding-bottom: 7rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-top: 17rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #e7e2d8;
  font-size: 21rpx;
}

.info-label {
  color: #878c82;
}

.info-value {
  color: #354b3e;
  font-weight: 500;
}

.demo-notice {
  display: flex;
  margin: 28rpx 0 25rpx;
  padding: 19rpx;
  border: 1rpx solid #e8ddc7;
  border-radius: 11rpx;
  background: #f1eadb;
}

.notice-symbol {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  margin: 2rpx 13rpx 0 0;
  border-radius: 50%;
  background: #b87954;
  color: #fffaf0;
  font-size: 20rpx;
}

.notice-copy {
  display: flex;
  flex-direction: column;
}

.notice-title {
  color: #6f593f;
  font-size: 20rpx;
  font-weight: 600;
}

.notice-text {
  margin-top: 5rpx;
  color: #847761;
  font-size: 18rpx;
  line-height: 1.65;
}

.back-button {
  width: 100%;
  height: 86rpx;
  border: 1rpx solid #41614d;
  border-radius: 10rpx;
  color: #355443;
  font-size: 23rpx;
}

.not-found-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 190rpx;
  padding: 40rpx 27rpx;
  border: 1rpx solid #e5e0d5;
  border-radius: 16rpx;
  background: #fffdf8;
}

.not-found-mark {
  color: #b87954;
  font-size: 48rpx;
}

.not-found-title {
  margin-top: 10rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.not-found-copy {
  margin: 9rpx 0 25rpx;
  color: #81877e;
  font-size: 20rpx;
}

.bottom-back {
  margin-bottom: 12rpx;
}

.route-map {
  width: 100%;
  height: 560rpx;
  margin-top: 18rpx;
  border-radius: 12rpx;
}

.map-message {
  display: block;
  margin-top: 12rpx;
  color: #6f786f;
  font-size: 22rpx;
  line-height: 1.7;
}

.map-message {
  padding: 20rpx;
  border-radius: 10rpx;
  background: #f1eadb;
}

.map-retry {
  margin-top: 16rpx;
}

.waypoint-card {
  margin-top: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #e5e0d5;
  border-radius: 12rpx;
  background: #fffdf8;
}

.waypoint-order, .waypoint-name, .waypoint-description {
  display: block;
}

.waypoint-order {
  color: #b87954;
  font-size: 19rpx;
}

.waypoint-name {
  margin-top: 8rpx;
  color: #30483b;
  font-size: 27rpx;
  font-weight: 600;
}

.waypoint-description {
  margin-top: 12rpx;
  color: #6f786f;
  font-size: 22rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.waypoint-card-actions {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.navigation-button { margin: 0; font-size: 22rpx; color: #355443; border: 1rpx solid #41614d; }
.navigation-note { display: block; margin-top: 14rpx; color: #6f786f; font-size: 20rpx; line-height: 1.7; }
.navigation-feedback { margin-top: 20rpx; padding: 20rpx; background: #fff6e6; border: 1rpx solid #e7c992; border-radius: 12rpx; }
.navigation-feedback-title { display: block; color: #795222; font-size: 26rpx; font-weight: 600; }
.navigation-feedback-message { display: block; margin-top: 10rpx; color: #795222; font-size: 24rpx; line-height: 1.7; }
.follow-panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #d3d9cf;
  border-radius: 16rpx;
  background: #f8f7f1;
}
.follow-title { display: block; color: #21483d; font-size: 30rpx; font-weight: 600; }
.follow-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.follow-actions .navigation-button { flex: 1; }
.follow-privacy { margin-top: 16rpx; padding-top: 12rpx; border-top: 1rpx solid #d3d9cf; }
.follow-status { display: block; margin-top: 8rpx; color: #41614d; font-size: 23rpx; }
.follow-metrics { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; padding: 20rpx 0; border-top: 1rpx solid #d3d9cf; border-bottom: 1rpx solid #d3d9cf; }
.follow-metrics > view { flex: 1; min-width: 130rpx; }
.follow-value { display: block; margin-top: 8rpx; color: #21483d; font-size: 27rpx; font-weight: 600; }
.follow-warning { display: block; margin-top: 16rpx; padding: 16rpx; background: #fff6e6; color: #795222; font-size: 23rpx; line-height: 1.7; border-radius: 12rpx; }
.follow-complete { margin-top: 16rpx; }
