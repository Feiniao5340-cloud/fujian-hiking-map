<view class="detail-page">
  <view wx:if="{{status === 'loading'}}" class="not-found-card">
    <text class="not-found-title">正在加载路线…</text>
    <text class="not-found-copy">请稍候</text>
    <button class="back-button" bindtap="onBackTap">返回路线列表</button>
  </view>
  <view wx:elif="{{status === 'invalid'}}" class="not-found-card">
    <text class="not-found-mark">?</text>
    <text class="not-found-title">缺少路线参数</text>
    <text class="not-found-copy">请从路线列表选择一条路线。</text>
    <button class="back-button" bindtap="onBackTap">返回路线列表</button>
  </view>
  <view wx:elif="{{status === 'error'}}" class="not-found-card">
    <text class="not-found-mark">!</text>
    <text class="not-found-title">路线加载失败</text>
    <text class="not-found-copy">请检查网络后重试。</text>
    <button class="back-button" bindtap="onRetryTap">重新加载</button>
    <button class="back-button bottom-back" bindtap="onBackTap">返回路线列表</button>
  </view>
  <view wx:elif="{{status === 'notFound'}}" class="not-found-card">
    <text class="not-found-mark">?</text>
    <text class="not-found-title">没有找到这条路线</text>
    <text class="not-found-copy">路线可能已被移除，请返回列表重新选择。</text>
    <button class="back-button" bindtap="onBackTap">返回路线列表</button>
  </view>

  <block wx:elif="{{status === 'success'}}">
    <view class="detail-hero">
      <view class="detail-orb"></view>
      <view class="detail-hill hill-back"></view>
      <view class="detail-hill hill-front"></view>
      <view class="detail-hero-top">
        <text class="mock-label">路线详情</text>
        <text class="route-type-label">{{route.displayRouteType}}</text>
      </view>
      <view class="detail-hero-copy">
        <text class="detail-location">{{route.city}} · {{route.displayDistrict}}</text>
        <text class="detail-title">{{route.name}}</text>
        <text class="detail-place">{{route.displayLocationText}}</text>
      </view>
    </view>

    <view class="stats-card">
      <view class="stat-cell">
        <text class="stat-label">全程距离</text>
        <text class="stat-value">{{route.displayDistance}}</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-cell">
        <text class="stat-label">预计用时</text>
        <text class="stat-value">{{route.displayDuration}}</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-cell">
        <text class="stat-label">难度</text>
        <text class="stat-value">{{route.displayDifficulty}}</text>
      </view>
    </view>

    <view class="detail-section">
      <view class="section-heading">
        <text class="section-marker">01</text>
        <text class="section-name">路线简介</text>
      </view>
      <text class="summary-copy">{{route.displaySummary}}</text>
    </view>

    <view class="detail-section info-section">
      <view class="section-heading">
        <text class="section-marker">02</text>
        <text class="section-name">路线信息</text>
      </view>
      <view class="info-row">
        <text class="info-label">累计爬升</text>
        <text class="info-value">{{route.displayElevationGain}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">路线类型</text>
        <text class="info-value">{{route.displayRouteType}}</text>
      </view>
    </view>

    <view class="detail-section map-section">
      <view class="section-heading">
        <text class="section-marker">03</text>
        <text class="section-name">路线地图</text>
      </view>
      <block wx:if="{{mapCenter}}">
        <map wx:if="{{!mapRenderError}}" id="route-map" class="route-map"
          latitude="{{mapCenter.latitude}}" longitude="{{mapCenter.longitude}}" scale="14"
          markers="{{mapMarkers}}"
          polyline="{{mapPolylines}}"
          include-points="{{mapIncludePoints}}"
          show-location="{{false}}" binderror="onMapError"
          bindmarkertap="onMarkerTap" bindcallouttap="onMarkerTap" bindregionchange="onMapRegionChange" bind:interpolatepoint="onNativeOverviewPoint" />
        <view wx:else class="map-message">
          <text>地图加载失败，请检查网络后重试。</text>
          <button class="back-button map-retry" bindtap="onRetryTap">重新加载</button>
        </view>
        <text wx:if="{{!mapCenter.polyline.length}}" class="map-message">轨迹资料不足，暂不显示轨迹。</text>
        <text wx:elif="{{mapCenter.discardedTrackPointCount > 0}}" class="map-message">部分轨迹资料暂不可用。</text>
      </block>
      <view wx:else class="map-message">起点位置暂不可用</view>
      <view class="follow-panel real-follow-panel">
        <text class="follow-title">真实GPS循迹（前台实验功能）</text>
        <text wx:if="{{followPlatformBlock}}" class="follow-warning" role="alert">{{followPlatformBlock}}</text>
        <text class="follow-status">{{followLabels[followState.status]}}</text>
        <text class="navigation-note">仅在本页前台、由您主动开启。退出或切到后台会停止，不自动恢复。不保存或上传位置历史。</text>
        <text class="navigation-note">真实蓝点来自手机定位，不吸附轨迹。B1进度与模拟演示分开；起点附近需连续确认。</text>
        <view class="follow-metrics">
          <text>定位质量：{{followState.qualityText}}</text>
          <text>定位精度：{{followState.accuracyText || '尚无真实位置'}}</text>
          <text>最近更新：{{followState.updatedText || '等待真实定位'}}</text>
          <text>B1已确认轨迹进度：{{followState.progressText}}</text>
          <text>参考已走：{{followState.walkedText}} · 参考剩余：{{followState.remainingText}}</text>
        </view>
        <text wx:if="{{followState.message}}" class="follow-warning" role="alert">{{followState.message}}</text>
        <text wx:if="{{followState.offRouteStatus === 'suspected'}}" class="follow-warning">疑似偏离路线，请结合现场道路确认。</text>
        <view class="follow-actions">
          <button class="navigation-button" bindtap="onStartFollowTap" disabled="{{!!followPlatformBlock || followState.cleanupPending || followState.status === 'stopping' || followState.status === 'starting' || followState.status === 'resuming' || followState.status === 'following' || followState.status === 'paused'}}">开始真实循迹（私人测试）</button>
          <button wx:if="{{followState.status === 'starting' || followState.status === 'resuming' || followState.status === 'following'}}" class="navigation-button" bindtap="onPauseFollowTap">暂停循迹</button>
          <button wx:if="{{followState.status === 'paused'}}" class="navigation-button" bindtap="onResumeFollowTap" disabled="{{!!followPlatformBlock}}">继续循迹</button>
          <button wx:if="{{followState.status === 'starting' || followState.status === 'resuming' || followState.status === 'following' || followState.status === 'paused' || followState.cleanupPending}}" class="navigation-button" bindtap="onStopFollowTap">{{followState.cleanupPending ? '重试停止定位' : '结束循迹'}}</button>
          <button class="navigation-button" bindtap="onFollowRecenterTap" disabled="{{!followState.location || followState.stale || followState.quality !== 'reliable'}}">回到当前位置</button>
          <button class="navigation-button" bindtap="onViewTrailTap" disabled="{{!mapCenter || mapRenderError}}">查看完整路线</button>
          <button wx:if="{{followState.canComplete}}" class="navigation-button" bindtap="onConfirmFollowTap">确认完成本次循迹</button>
        </view>
        <button class="navigation-button" bindtap="onCheckFollowPrivacyTap" loading="{{followPrivacyStatus === 'checking'}}" disabled="{{followPrivacyStatus === 'checking'}}">检查隐私授权（不启动定位）</button>
        <button class="navigation-button" bindtap="onFollowPrivacyView">阅读隐私保护指引</button>
        <text class="navigation-note">{{followPrivacyMessage}}</text>
        <view wx:if="{{followPrivacyVisible}}" class="follow-privacy">
          <text>请阅读《{{followPrivacyContractName}}》。同意只处理微信隐私授权，不会自动定位；之后请主动点击开始或继续。</text>
          <button id="follow-privacy-agree" class="navigation-button" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onFollowPrivacyAgree">同意隐私指引</button>
          <button class="navigation-button" bindtap="onFollowPrivacyCancel">暂不授权</button>
        </view>
        <text class="navigation-note">算法阈值待设备与受控步行校准（CALIBRATION_PENDING）。当前不提供后台定位或专业安全导航。</text>
        <text wx:if="{{nativeRecoveryMessage}}" class="follow-warning" role="alert">{{nativeRecoveryMessage}}</text>
        <button class="navigation-button" bindtap="onRetryNativeCleanupTap">检查／重试路线速览清理</button>
        <text wx:if="{{accessRecoveryMessage}}" class="follow-warning" role="alert">{{accessRecoveryMessage}}</text>
        <button wx:if="{{accessRecoveryMessage}}" class="navigation-button" bindtap="onAccessRecoveryTap">检查单次定位请求状态</button>
      </view>
      <view wx:if="{{overviewMode}}" class="simulation-panel">
        <text class="simulation-title">路线速览</text>
        <text class="simulation-warning">本功能根据正式徒步轨迹快速展示路线走向，仅用于地图演示，不代表实时GPS定位或实时轨迹匹配。</text>
        <text class="navigation-note">暂停时会走完当前短段再停，预计最多约1秒。</text>
        <text class="simulation-status">{{overviewState.text}}</text>
        <view class="simulation-controls">
          <button class="navigation-button" bindtap="onSimulationStartTap" disabled="{{overviewState.status === 'playing' || overviewState.status === 'starting' || overviewState.status === 'pausing'}}">开始速览</button>
          <button class="navigation-button" bindtap="onSimulationPauseTap" disabled="{{overviewState.status !== 'playing'}}">暂停</button>
          <button class="navigation-button" bindtap="onSimulationResumeTap" disabled="{{overviewState.status !== 'paused'}}">继续</button>
          <button class="navigation-button" bindtap="onSimulationRestartTap">重新播放</button>
        </view>
        <text class="navigation-note">{{overviewState.message}}</text>
      </view>
      <view wx:else class="simulation-panel">
        <text class="simulation-title">轨迹模拟演示</text>
        <text class="simulation-warning">虚拟位置演示，不代表真实GPS定位。</text>
        <text class="simulation-status">{{mapCenter ? simulationState.statusText : '当前路线不支持模拟'}}</text>
        <view class="simulation-actions">
          <button class="navigation-button" bindtap="onSimulationStartTap" disabled="{{!mapCenter || mapRenderError || simulationState.status !== 'idle'}}">开始模拟</button>
          <button class="navigation-button" bindtap="onSimulationPauseTap" disabled="{{simulationState.status !== 'playing'}}">暂停</button>
          <button class="navigation-button" bindtap="onSimulationResumeTap" disabled="{{!mapCenter || mapRenderError || simulationState.status !== 'paused'}}">继续</button>
          <button class="navigation-button" bindtap="onSimulationRestartTap" disabled="{{!mapCenter || mapRenderError}}">重新播放</button>
        </view>
        <text class="navigation-note">模拟播放位置：{{simulationState.playbackText}}</text>
        <text class="navigation-note">B1已确认进度：{{simulationState.matchedText}}</text>
        <text class="navigation-note">剩余轨迹距离：{{simulationState.remainingText}}</text>
        <text class="navigation-note">{{simulationState.b1Text}}</text>
        <text class="navigation-note">自动快速演示，标准目标约17秒。播放位置与B1匹配进度可能不同，不代表实际徒步用时。</text>
        <text wx:if="{{simulationState.message}}" class="simulation-warning" role="alert">{{simulationState.message}}</text>
      </view>
      <view wx:if="{{accessConsent.visible}}" class="access-consent-mask" catchtap="onAccessConsentCancel" data-request-id="{{accessConsent.requestId}}">
        <view class="access-consent-card" role="dialog" aria-modal="true" catchtap="onAccessConsentContentTap">
          <text class="follow-title">本次步行接驳的第三方服务</text>
          <text>服务提供方：{{accessConsent.providerLegalName || '法律主体待项目所有者核实，当前禁止规划'}}</text>
          <text>服务：高德步行路线规划 Web API（非客户端SDK）</text>
          <text>目的：规划您本次当前位置到“{{accessConsent.targetName}}”的临时步行接驳。</text>
          <text>您同意本次请求并完成微信必要授权后，起点和终点坐标将经CloudBase发送给高德。拒绝不影响查看绿色轨迹和节点。</text>
          <text selectable="true">高德隐私政策：{{accessConsent.policyUrl}}</text>
          <button class="navigation-button" catchtap="onAccessPolicyTap" data-request-id="{{accessConsent.requestId}}" disabled="{{accessConsent.stage !== 'pending'}}">阅读高德隐私政策</button>
          <text wx:if="{{accessConsent.blockedReason}}" class="follow-warning" role="alert">{{accessConsent.blockedReason}}</text>
          <text wx:if="{{accessConsent.message}}" class="follow-warning" role="alert">{{accessConsent.message}}</text>
          <view wx:if="{{accessConsent.stage === 'wechatPrivacy'}}">
            <button class="navigation-button" catchtap="onAccessWeChatPrivacyView" data-request-id="{{accessConsent.requestId}}">阅读微信隐私保护指引</button>
            <button id="access-wechat-privacy-agree" class="navigation-button" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onAccessWeChatPrivacyAgree" data-request-id="{{accessConsent.requestId}}" disabled="{{accessConsent.wechatPolicyFailed}}">同意微信隐私指引</button>
          </view>
          <button class="navigation-button" catchtap="onAccessConsentAgree" data-request-id="{{accessConsent.requestId}}" disabled="{{!accessConsent.ready || accessConsent.stage !== 'pending'}}">同意并规划</button>
          <button class="navigation-button" catchtap="onAccessConsentCancel" data-request-id="{{accessConsent.requestId}}">暂不使用</button>
          <text class="navigation-note">本次同意不永久保存，也不启用真实GPS循迹。关闭此说明即取消本次意图。</text>
        </view>
      </view>
      <view wx:if="{{selectedWaypoint}}" class="waypoint-card">
        <text class="waypoint-order">节点 {{selectedWaypoint.order}}</text>
        <text class="waypoint-name">{{selectedWaypoint.name}}</text>
        <text wx:if="{{selectedWaypoint.description}}" class="waypoint-description">{{selectedWaypoint.description}}</text>
        <text wx:else class="waypoint-description">暂无节点说明</text>
        <view wx:if="{{accessRoute.errorCode === 'WALKING_RANGE_EXCEEDED'}}" class="navigation-feedback">
          <text class="navigation-feedback-title">距离超出步行规划范围</text>
          <text class="navigation-feedback-message">{{navigationMessage}}</text>
        </view>
        <view class="waypoint-card-actions">
          <button class="navigation-button" bindtap="onOpenTargetTap" loading="{{nativeNavigation.status === 'opening'}}" disabled="{{nativeNavigation.status === 'opening'}}">打开目标位置</button>
          <button class="navigation-button" bindtap="onPlanAccessTap" loading="{{accessRoute.status === 'locating' || accessRoute.status === 'planning'}}" disabled="{{nativeNavigation.status === 'opening' || accessRoute.status === 'locating' || accessRoute.status === 'planning'}}">规划到这里</button>
        </view>
        <text class="navigation-note">打开微信原生地图中的目标位置。</text>
        <text class="navigation-note">步行接驳最多支持100公里；远距离出行请使用“打开目标位置”。</text>
        <text class="navigation-note">目标：{{selectedWaypoint.name}}</text>
        <text class="navigation-note">点击规划时获取一次位置，经云服务与高德规划步行接驳。绿色为徒步路线，蓝色为临时接驳路线；规划不保证山路可通行。</text>
        <text wx:if="{{accessRoute.status === 'locating'}}" class="navigation-note">正在获取当前位置…</text>
        <text wx:elif="{{accessRoute.status === 'planning'}}" class="navigation-note">正在规划步行接驳…</text>
        <view wx:elif="{{accessRoute.status === 'success'}}">
          <text class="navigation-note">接驳距离：{{accessSummary.distance}}</text>
          <text class="navigation-note">预计步行：{{accessSummary.minutes}} min</text>
          <button class="navigation-button" bindtap="onClearAccessTap">清除接驳路线</button>
        </view>
        <text wx:if="{{navigationMessage && accessRoute.errorCode !== 'WALKING_RANGE_EXCEEDED'}}" class="navigation-note">{{navigationMessage}}</text>
      </view>
      <text wx:if="{{navigationMessage && !selectedWaypoint}}" class="navigation-note">{{navigationMessage}}</text>
    </view>


    <button class="back-button bottom-back" bindtap="onBackTap">返回路线列表</button>
  </block>
</view>
